package ticketbooking.repository;


import com.ticketbooking.platform.entity.Booking;
import com.ticketbooking.platform.enums.BookingStatus;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;

import java.util.Optional;

public interface BookingRepository extends JpaRepository<Booking, Long> {

    Optional<Booking> findByBookingNumber(String bookingNumber);

    Page<Booking> findByUserIdOrderByCreatedAtDesc(
            Long userId,
            Pageable pageable
    );

    boolean existsByShowIdAndStatus(
            Long showId,
            BookingStatus status
    );
}