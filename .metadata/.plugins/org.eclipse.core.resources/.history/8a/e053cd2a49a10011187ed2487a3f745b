package ticketbooking.controller;


import com.ticketbooking.platform.dto.MovieResponse;
import com.ticketbooking.platform.service.MovieService;
import lombok.RequiredArgsConstructor;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.data.domain.Sort;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/v1/movies")
@RequiredArgsConstructor
public class MovieController {

    private final MovieService movieService;

    @GetMapping
    public Page<MovieResponse> getMovies(

            @RequestParam(required = false)
            String search,

            @RequestParam(defaultValue = "0")
            int page,

            @RequestParam(defaultValue = "10")
            int size) {

        Pageable pageable = PageRequest.of(
                page,
                size,
                Sort.by("title").ascending()
        );

        return movieService.getMovies(search, pageable);
    }

    @GetMapping("/{movieId}")
    public MovieResponse getMovie(
            @PathVariable Long movieId) {

        return movieService.getMovie(movieId);
    }
}